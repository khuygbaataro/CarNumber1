# Base URL of the backend API (include the /api suffix)
# Local:  http://localhost:5000/api
# Deploy: https://your-backend.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ---- Messenger add-car bot (Vercel serverless API route) ----
# MongoDB (same cluster/db as the backend)
MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxx.mongodb.net/dealership

# Cloudinary (same account as the backend)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Anthropic (Claude API)
ANTHROPIC_API_KEY=sk-ant-...
# Optional model override (defaults to claude-opus-4-8)
# ANTHROPIC_MODEL=claude-opus-4-8

# Facebook Messenger
MESSENGER_VERIFY_TOKEN=pick_any_random_string
MESSENGER_PAGE_ACCESS_TOKEN=EAAG...
MESSENGER_APP_SECRET=your_fb_app_secret
# Comma-separated Facebook PSIDs allowed to add/sell cars (staff only)
MESSENGER_ADMIN_IDS=1234567890,9876543210
# Auto-post new cars to the FB page feed. Set to "false" or "0" to disable.
MESSENGER_AUTOPOST=true
